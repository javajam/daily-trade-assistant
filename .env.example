# Copy to .env and fill in paper keys. Never commit .env.
#
# Paper keys: https://app.alpaca.markets → paper account → API Keys
# (or https://app.alpaca.markets/paper/dashboard/overview)
# Paper trading REST endpoint used by this bot:
#   https://paper-api.alpaca.markets
# Market data:
#   https://data.alpaca.markets  (IEX feed by default)

ALPACA_API_KEY=
ALPACA_API_SECRET=

# Optional aliases (Alpaca SDK names) — either pair works
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=

# Live trading is OFF unless ALL of the following are true:
#   1) settings.allow_live: true  in your rules YAML (default false)
#   2) ALPACA_LIVE_TRADING=true
#   3) ALPACA_ALLOW_LIVE=I_UNDERSTAND
#   4) you are using live (not paper) API keys
# Missing any one of these keeps the bot on the paper endpoint.
ALPACA_LIVE_TRADING=false
# ALPACA_ALLOW_LIVE=

# Set to 1 to halt new orders immediately (same effect as `python -m dta_bot pause`)
DTA_KILL_SWITCH=0
